# Copy this file to .env and fill in your actual values
GROQ_API_KEY=your_groq_api_key_here

# SQL backend: duckdb (default, in-memory demo data) or databricks
ANALYTICS_BACKEND=duckdb

# Databricks SQL Warehouse (only needed when ANALYTICS_BACKEND=databricks;
# requires `pip install -e ".[databricks]"`)
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
DATABRICKS_TOKEN=your_databricks_personal_access_token
# Optional Unity Catalog scoping for schema introspection
DATABRICKS_CATALOG=your_catalog
DATABRICKS_SCHEMA=your_schema

# Eval harness: minimum execution accuracy (0-1) before the run exits non-zero
EVAL_MIN_ACCURACY=0.8
